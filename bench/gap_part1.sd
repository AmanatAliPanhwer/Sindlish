likh("=== GAP TEST 1-4: BASICS + TYPES + DECLS ===")
likh("Salam, Duniay!")
likh('Salam, Sindh!')
likh(42)
likh(sach)
likh(koorh)
likh(khali)
likh("Salam", "Sindh", 2024)
likh("")

adad num1
likh("adad default:", num1)
dahai num2
likh("dahai default:", num2)
lafz text1
likh("lafz default:", text1)
faislo flag1
likh("faislo default:", flag1)
khali nothing
likh("khali default:", nothing)
likh("")

x = 10
likh("Dynamic:", x)
x = "now I'm a string"
likh("   Can change to:", x)
adad age = 25
likh("Typed with value:", age)
lafz name2
likh("Typed without value:", name2)
count: adad = 100
likh("Postfix annotation:", count)
likh("")

likh("=== GAP TEST 5: NUMBERS ===")
likh("   Positive:", 42)
likh("   Negative:", -42)
likh("   Zero:", 0)
likh("   Standard:", 3.14159)
likh("   Leading dot:", .5)
likh("   Trailing dot:", 5.)
likh("   Negative:", -2.718)
likh("Mixed int + float:", 5 + 3.14)
likh("Integer division:", 10 / 4)
likh("")

likh("=== GAP TEST 6: STRINGS ===")
likh("   Double quotes:", "Hello")
likh("   Single quotes:", 'Hello')
likh("   With +:", "Salam" + " " + "Duniay")
likh("   'Ha' * 3:", "Ha" * 3)
lafz word = "Sindlish"
likh("   word[0]:", word[0])
likh("   word[-1]:", word[-1])
likh("")

likh("=== GAP TEST 7-8: BOOLEANS + NULL ===")
likh("   sach:", sach)
likh("   koorh:", koorh)
likh("Null value:", khali)
likh("")

likh("=== GAP TEST 9: ARITHMETIC ===")
likh("   10 + 5 =", 10 + 5)
likh("   10 - 5 =", 10 - 5)
likh("   10 * 5 =", 10 * 5)
likh("   10 / 4 =", 10 / 4)
likh("   10 % 3 =", 10 % 3)
likh("   2 ^ 8 =", 2 ^ 8)
likh("   -5 =", -5)
likh("   -(-3) =", -(-3))
likh("   2 + 3 * 4 =", 2 + 3 * 4)
likh("   (2 + 3) * 4 =", (2 + 3) * 4)
likh("")

likh("=== GAP TEST 10: COMPARISON ===")
likh("   5 == 5 is", 5 == 5)
likh("   5 == 3 is", 5 == 3)
likh("   5 != 3 is", 5 != 3)
likh("   5 != 5 is", 5 != 5)
likh("   10 > 5 is", 10 > 5)
likh("   3 > 5 is", 3 > 5)
likh("   3 < 5 is", 3 < 5)
likh("   10 < 5 is", 10 < 5)
likh("   5 >= 5 is", 5 >= 5)
likh("   6 >= 5 is", 6 >= 5)
likh("   5 <= 5 is", 5 <= 5)
likh("   4 <= 5 is", 4 <= 5)
likh("")

likh("=== GAP TEST 11: LOGICAL ===")
likh("   sach aen sach is", sach aen sach)
likh("   sach aen koorh is", sach aen koorh)
likh("   sach ya koorh is", sach ya koorh)
likh("   koorh ya koorh is", koorh ya koorh)
likh("   nah sach is", nah sach)
likh("   !koorh is", !koorh)
likh("   (5 > 3) aen (10 < 20) is", (5 > 3) aen (10 < 20))
likh("")

likh("=== GAP TEST 12: IF/ELSE ===")
x = 10
agar x > 5 {
    likh("   x is greater than 5")
}
x = 3
agar x > 5 {
    likh("   Big")
} warna {
    likh("   Small")
}
x = 7
agar x > 10 {
    likh("   Very big")
} yawari x > 5 {
    likh("   Medium")
} warna {
    likh("   Small")
}
likh("")

likh("=== GAP TEST 13: WHILE ===")
x = 1
jistain x <= 3 {
    likh("   Count:", x)
    x = x + 1
}
likh("")

likh("=== GAP TEST 13a: FOR ===")
har i mein range(3) {
    likh("   i =", i)
}
nums = [10, 20, 30]
har n mein nums {
    likh("   n =", n)
}
far = [1, 2]
har x2 mein far {
    likh("   x =", x2)
}
likh("")

likh("=== GAP TEST 13c: BREAK/CONTINUE ===")
har i mein range(10) {
    agar i == 3 {
        likh("   Breaking at 3")
        tor
    }
    likh("   i =", i)
}
har i mein range(5) {
    agar i == 2 {
        likh("   Skipping 2")
        jari
    }
    likh("   i =", i)
}
likh("")
