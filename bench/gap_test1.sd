likh("=== GAP TEST 1: BASICS ===")
likh("Salam, Duniay!")
likh('Salam, Sindh!')
likh(42)
likh(sach)
likh(koorh)
likh(khali)
likh("Salam", "Sindh", 2024)
likh("")

likh("=== GAP TEST 2: COMMENTS ===")
likh("Comments complete!")

likh("=== GAP TEST 3: DATA TYPES ===")
adad num1
likh("adad default:", num1)
dahai num2
likh("dahai default:", num2)
lafz text1
likh("lafz default:", text1)
faislo flag1
likh("faislo default:", flag1)
khali nothing
likh("khali default:", nothing)
likh("")

likh("=== GAP TEST 4: VARIABLE DECLARATIONS ===")
x = 10
likh("Dynamic:", x)
x = "now I'm a string"
likh("   Can change to:", x)
adad age = 25
likh("Typed with value:", age)
lafz name2
likh("Typed without value:", name2)
count: adad = 100
likh("Postfix annotation:", count)

